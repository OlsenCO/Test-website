# --- Required ---------------------------------------------------------------
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Platform fee in basis points (1500 = 15%, 2000 = 20%)
PLATFORM_FEE_BPS=1500

# --- Stripe Connect (optional in dev) ---------------------------------------
# Without STRIPE_SECRET_KEY the app runs in test mode: "Connect Stripe" makes a
# simulated account and checkout is replaced by a "simulate payment" page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Google Calendar + Meet (optional) --------------------------------------
# OAuth client (Web application). Authorized redirect URI:
#   ${APP_URL}/api/google/callback
# Without it, bookings get a Jitsi link and an .ics invite instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional) -------------------------------------------------------
# Confirmation/cancellation emails via Resend. Unset = logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Mentor Minutes <bookings@yourdomain.com>"
